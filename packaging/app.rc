// Windows resources of the executable: icon (Explorer, taskbar, GLFW window) and version information
#include <windows.h>

IDI_ICON1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,3,0,0
PRODUCTVERSION  0,3,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName",      "Luca Santoro"
            VALUE "FileDescription",  "SWE Vulkan - simulation de crues et de nappes en 3D"
            VALUE "FileVersion",      "0.3.0"
            VALUE "InternalName",     "swe"
            VALUE "OriginalFilename", "SWE-Vulkan.exe"
            VALUE "ProductName",      "SWE Vulkan"
            VALUE "ProductVersion",   "0.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x40C, 1200
    END
END
